# --- baza (docker compose) ---
DB_USER=roombooking
DB_PASSWORD=change-me
DB_NAME=roombooking

# --- aplikacja uruchamiana lokalnie (npm start); w Dockerze DATABASE_URL ustawia docker-compose.yml ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://roombooking:change-me@localhost:5432/roombooking
# wygeneruj: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m

# --- testy integracyjne (osobna baza, tworzona automatycznie przez tests/globalSetup.js) ---
TEST_DATABASE_URL=postgres://roombooking:change-me@localhost:5432/roombooking_test
